# kettera_corp_portal — build-time environment template.
#
# Vite bakes VITE_* variables into the JS bundle at build time.
# Changing them requires a rebuild-and-redeploy.
#
# Copy to `.env.local` for local dev (already covered by .gitignore).
# Prod values are set in the Static Web Apps GitHub Actions workflow
# (env:) OR in Azure portal → Static Web Apps → Configuration →
# Build environment variables.

# The API URL. Local dev = wherever kettera_corp_api is running.
VITE_API_BASE_URL=http://localhost:3100

# Firebase client config for the kettera-architect project.
# These are the SAME values Navigator ships — public config, safe
# in the bundle. The real security lives in the local portal_user
# gate on the API, not in these values.
VITE_FIREBASE_API_KEY=AIzaSyAHJ-gk5RoDOuS9Wh5LyY_nMg7USrTBQng
VITE_FIREBASE_AUTH_DOMAIN=kettera-architect.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kettera-architect
VITE_FIREBASE_STORAGE_BUCKET=kettera-architect.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=406578154231
VITE_FIREBASE_APP_ID=1:406578154231:web:b92dbace76e75f425c61f2
