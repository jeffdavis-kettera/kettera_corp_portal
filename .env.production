# Kettera Corp Portal — production build-time environment.
#
# CHECKED INTO GIT ON PURPOSE. These are Vite VITE_* values that get
# baked into the client bundle at build time; every browser that
# loads the deployed app sees them, so hiding them in a build
# secret would be theater. See:
#   - Navigator's same pattern in kettera_architect/.env.production
#   - https://firebase.google.com/docs/projects/api-keys ("safe to
#     include in code or checked-in config files")
#   - The plan doc's "Credential handling" section
#
# Real secrets (SQL password, Firebase Admin service-account JSON)
# live only in Azure App Service Configuration on the API side.
#
# HOW TO OVERRIDE: values set in the Static Web Apps GitHub Actions
# workflow's env: block OR in Azure portal → SWA → Configuration →
# Build environment variables take PRECEDENCE over this file, so a
# preview environment can point at a different API URL or Firebase
# project without editing this file.

# ─────────────────────────────────────────────────────────────────
# Corp Portal API base URL.
#
# NO /api suffix — routes in kettera_corp_api's server.js mount at
# the root (/session, /modules, /portal-users), unlike Navigator's
# API which nests everything under /api. The frontend calls
# `${API_BASE_URL}/session/me`, which lands at the right place with
# the origin alone.
#
# The SWA build environment's VITE_API_BASE_URL, if set, wins over
# this line — useful for preview environments pointing elsewhere.
# ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://api.ketterasolutions.com

# ─────────────────────────────────────────────────────────────────
# Firebase client config for the kettera-architect project.
# Same values Navigator ships — public config, safe in git.
# The real security lives in the API's portal_user gate + Firebase
# Auth's server-side rules, not in these values.
# ─────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=AIzaSyAHJ-gk5RoDOuS9Wh5LyY_nMg7USrTBQng
VITE_FIREBASE_AUTH_DOMAIN=kettera-architect.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kettera-architect
VITE_FIREBASE_STORAGE_BUCKET=kettera-architect.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=406578154231
VITE_FIREBASE_APP_ID=1:406578154231:web:b92dbace76e75f425c61f2
